import java.util.Scanner;


// this creates a method which takes in a message parameter and then prints it out, it then collects the input from the user and then returns it
public static int input_start_height(String message)
{
    Scanner scanner = new Scanner(System.in);
    System.out.println(message);

    int value = Integer.parseInt(scanner.nextLine());

    return value;

}//end input value


// this creates a method which takes in a message parameter and then prints it out, it then collects the input from the user and then returns it
public static int input_water_count(String message)
{
    Scanner scanner = new Scanner(System.in);
    System.out.println(message);

    int value = Integer.parseInt(scanner.nextLine());

    return value;

}//end input value


// this creates a method which takes in a message parameter and then prints it out, it then collects the input from the user and then returns it
public static int input_sunlight(String message)
{
    Scanner scanner = new Scanner(System.in);
    System.out.println(message);

    int value = Integer.parseInt(scanner.nextLine());

    return value;

}//end input value


// this value takes in the number of hours of sunlight and the water count and then performs a calculation to find plant growth
public static double calculate_growth(int sunlight, int water_count)
{
    final double sunlight_modifier = 0.5;
    final double water_modifier = 1.2;

    double growth = (sunlight_modifier * sunlight) + (water_modifier * water_count);

    return growth;

}//end calculator


// this calculates the final expected height by adding growth onto starting height
public static double calculate_height(double growth, int start_height)
{
    double final_value = growth + start_height;

    return final_value;

}//end calculator


// this calculates the percentage increase in height
public static int calculate_percentage(double growth, int start_height)
{
    double percentage = (growth / start_height) * 100;

    int final_percentage = (int) Math.ceil(percentage);

    return final_percentage;

}//end calculator


//this prints out all the final values
public static void print_values(int start_height, double final_value, double growth, int percentage)
{
    System.out.println("Your starting height is " + start_height + ".0cm.");
    System.out.println("Your expected height is " + final_value + "cm.");
    System.out.println("That is an expected growth of " + growth + "cm.");
    System.out.println("That would be a " + percentage + "% increase this week.");

    return;

}//end print values


public static void main()
{
    String message_start_height = "How tall is your plant in cm? (a whole number)";
    String message_sunlight = "How many hours of sunlight has your plant had this week (a whole number)?";
    String message_water = "How many times have you watered your plant this week (a whole number)?";
 
 
    int start_height = input_start_height(message_start_height);
    int sunlight = input_sunlight(message_sunlight);
    int water_count = input_water_count(message_water);

    double growth = calculate_growth(sunlight, water_count);
    double final_value = calculate_height(growth, start_height);
    int percentage = calculate_percentage(growth, start_height);

    print_values(start_height, final_value, growth, percentage);

    return;

}//end main


main();